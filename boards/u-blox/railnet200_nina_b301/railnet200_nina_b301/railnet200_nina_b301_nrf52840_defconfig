# Enable MPU
CONFIG_ARM_MPU=y

# Enable hardware stack protection
CONFIG_HW_STACK_PROTECTION=y

# Enable GPIO
CONFIG_GPIO=y

# Enable UART (required for HCI transport)
CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=y

# Disable console output — the UART is fully dedicated to HCI
CONFIG_CONSOLE=n
CONFIG_UART_CONSOLE=n
